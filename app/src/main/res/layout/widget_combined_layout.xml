<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FF16323A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/combined_prayer_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFF3ECDC"
            android:text="العشاء - متبقي للصلاة"/>
        <TextView
            android:id="@+id/combined_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFE8C468"
            android:text="3س 24د"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <TextView
                android:id="@+id/crow1_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFF3ECDC"
                android:text="الفجر"
                android:singleLine="true"/>
            <TextView
                android:id="@+id/crow1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF8FA9AF"
                android:text="٤:٥٢ ص"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:id="@+id/crow1_toggle"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF4E8B6B"
                android:text="✓"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <TextView
                android:id="@+id/crow2_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFF3ECDC"
                android:text="الظهر"
                android:singleLine="true"/>
            <TextView
                android:id="@+id/crow2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF8FA9AF"
                android:text="١٢:٥٨ م"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:id="@+id/crow2_toggle"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF8FA9AF"
                android:text="○"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <TextView
                android:id="@+id/crow3_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFF3ECDC"
                android:text="العصر"
                android:singleLine="true"/>
            <TextView
                android:id="@+id/crow3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF8FA9AF"
                android:text="٤:٣٥ م"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:id="@+id/crow3_toggle"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF8FA9AF"
                android:text="○"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <TextView
                android:id="@+id/crow4_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFF3ECDC"
                android:text="المغرب"
                android:singleLine="true"/>
            <TextView
                android:id="@+id/crow4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF8FA9AF"
                android:text="٧:٣١ م"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:id="@+id/crow4_toggle"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF8FA9AF"
                android:text="○"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <TextView
                android:id="@+id/crow5_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFF3ECDC"
                android:text="العشاء"
                android:singleLine="true"/>
            <TextView
                android:id="@+id/crow5_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF8FA9AF"
                android:text="٨:٥٣ م"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:id="@+id/crow5_toggle"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF8FA9AF"
                android:text="○"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
